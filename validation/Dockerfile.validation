FROM golang:1.25-alpine AS go-builder
RUN apk add --no-cache git bash build-base
WORKDIR /app
COPY . .
RUN go build -o bin/noctifab cmd/noctifab/main.go

FROM python:3.12-alpine
RUN apk add --no-cache git bash rust cargo
WORKDIR /app

# Copy the built binary
COPY --from=go-builder /app/bin/noctifab /usr/local/bin/noctifab

# Copy the validation projects
COPY validation/projects /app/projects

# Copy the scripts and set them up
COPY validation/validate.sh /app/validate.sh
RUN chmod +x /app/validate.sh

# Run the verification script directly in the container
CMD ["/app/validate.sh"]

